# Copy this file to .env and fill in your values. .env is gitignored — never commit it.
# Single source of local-dev config + secrets: read by docker-compose (containers) AND by
# the API via DotNetEnv (the App secrets below). See docs/DECISIONS.md.

# ── Containers (docker-compose) ──────────────────────────────────────────────
# PostgreSQL
DB_NAME=dev_db
DB_USER=dev
DB_PASSWORD=devpassword
DB_PORT=5433

# Mailpit (SMTP trap)
MAIL_SMTP_PORT=1025
MAIL_UI_PORT=8025

# ── App secrets (.NET config; double underscore __ = section nesting) ─────────
# REQUIRED — Postgres connection string for the API + EF tooling. Single source of the DB
# connection (not in appsettings); mirror the DB_* container values above.
ConnectionStrings__DefaultConnection="Host=localhost;Port=5433;Database=dev_db;Username=dev;Password=devpassword"

# Optional — two-role RLS topology (ADR-020). Local dev's `dev` user is a Postgres superuser, so
# RLS is bypassed by design (the test suite enforces it via its own runtime role). To run the app
# RLS-enforced like staging/prod: point DefaultConnection at the app_runtime role (provisioned by
# docker/db/provision-rls-runtime-role.sql on a fresh volume), keep the owner connection for
# startup migrations, and enable the fail-closed posture guard.
#ConnectionStrings__DefaultConnection="Host=localhost;Port=5433;Database=dev_db;Username=app_runtime;Password=app_runtime_password"
#ConnectionStrings__Migrations="Host=localhost;Port=5433;Database=dev_db;Username=dev;Password=devpassword"
#Rls__EnforceRuntimeRole=true

# REQUIRED — JWT signing key (>= 32 chars).
Jwt__Secret=

# Optional — passwordless (OTP/magic-link) per-IP rate limit (requests/minute). Defaults to 5 in
# production; raised only for the E2E stack, where the whole browser suite shares one source IP.
#Auth__RateLimit__PasswordlessPermitLimit=5

# Optional — OAuth. A provider registers only when its ClientId is set.
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=
Authentication__Microsoft__ClientId=
Authentication__Microsoft__ClientSecret=
# Microsoft only — which account types may sign in: "common" (work/school + personal, default),
# "organizations", "consumers", or a specific tenant id. Drives the email-trust policy (ADR-002).
#Authentication__Microsoft__Tenant=common

# Optional — SMTP. Leave unset to use the Mailpit trap (localhost:1025) in dev.
# For a real provider (e.g. Brevo), set all six.
#Email__Smtp__Host=smtp-relay.brevo.com
#Email__Smtp__Port=587
#Email__Smtp__Username=
#Email__Smtp__Password=
#Email__Smtp__FromAddress=
#Email__Smtp__FromName=Perezosoft
# macOS dev boxes only: Apple trust eval can fail a real relay's TLS handshake with
# "incomplete certificate revocation check". Set false locally; never in production.
#Email__Smtp__CheckCertificateRevocation=true

# Optional — Stripe billing (ADR-006). Leave SecretKey unset to use the in-memory FakeBillingProvider
# (checkout returns a fake URL; zero real charges). Set SecretKey + a price id per paid plan for real
# Checkout. Get test keys/prices from the Stripe dashboard (test mode).
#Billing__Stripe__SecretKey=sk_test_...
#Billing__Stripe__Prices__pro=price_...
# Webhook signing secret (whsec_...) for verifying inbound webhooks (BILLING-3). From the Stripe
# dashboard, or printed by `stripe listen` when forwarding events to the local API.
#Billing__Stripe__WebhookSecret=whsec_...

# Optional — File storage (ADR-010). Leave Storage__S3__Bucket unset to use local disk (files under
# ./storage, zero setup). Set a bucket to switch to any S3-compatible backend — the SAME impl targets
# AWS S3, MinIO (staging), Cloudflare R2, Backblaze B2, etc.; only these values change.
#   • AWS S3:            set Bucket + Region + AccessKey + SecretKey (leave Endpoint empty).
#   • MinIO / R2 / B2:   also set Endpoint and ForcePathStyle=true.
# DownloadBaseUrl is the API's own public origin, used to build local-disk /api/files/{token} URLs
# (not needed for S3 — it returns native presigned URLs).
#Storage__Local__DownloadBaseUrl=https://localhost:7160
#Storage__S3__Bucket=
#Storage__S3__Region=us-east-1
#Storage__S3__Endpoint=            # e.g. http://localhost:9000 (MinIO) or https://<accountid>.r2.cloudflarestorage.com
#Storage__S3__AccessKey=
#Storage__S3__SecretKey=
#Storage__S3__ForcePathStyle=true  # required for MinIO and most non-AWS S3s

# Optional — Platform-staff admin surface (ADR-014). The allowlist of emails permitted to use the admin
# back-office (cross-tenant inspection + impersonation). OUT-OF-BAND: settable only here, never from the
# app, never a tenant role. Leave unset ⇒ no platform staff. Indexed keys for the array:
#Admin__StaffEmails__0=you@yourcompany.com
#Admin__StaffEmails__1=oncall@yourcompany.com

# Optional — Public API + API keys (PUBAPI, ADR-015). DEFAULT OFF: leave unset/false and the API-key
# auth scheme isn't added and the /api/apikeys + /api/public routes aren't mapped (they 404). Set true to
# expose the public surface so tenants can mint API keys and call it programmatically.
#PublicApi__Enabled=true

# Optional — Outbound webhooks (HOOKS, ADR-016). DEFAULT OFF: leave unset/false and the /api/webhooks
# management routes aren't mapped (404). Set true to let tenants register endpoints; deliveries go through
# the outbox (durable + retried), HMAC-signed with each subscription's secret.
#Webhooks__Enabled=true

# Optional — OpenTelemetry (OBS-2, ADR-008). Leave unset for no exporter (spans/metrics still collected).
# Set the OTLP endpoint to ship to a collector (Jaeger/Tempo/Honeycomb/…); ConsoleExporter=true prints
# telemetry to stdout for local debugging.
#OpenTelemetry__Otlp__Endpoint=http://localhost:4317
#OpenTelemetry__ConsoleExporter=true

# Optional — Deployment (DEPLOY-1, ADR-017). Single-origin hosting: when true the API also serves the
# published Blazor WASM client, so the whole app is ONE origin (first-party refresh cookie, no CORS).
# Default off — local dev uses the separate `dotnet run --project src/Web` dev server. The deployed
# container sets this true and ships the published wwwroot next to the API.
#Hosting__ServeWebClient=true

# Behind a TLS-terminating reverse proxy (Render/nginx): honor X-Forwarded-For/-Proto so the real client
# IP drives the per-IP rate limiter and the https scheme drives OAuth redirect URIs. Default off — trusting
# these headers with NO proxy in front lets a client spoof its IP. Turn on ONLY when a proxy sets them.
#Proxy__Enabled=true
