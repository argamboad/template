@using System.Globalization
@using System.Net.Http.Json
@using Template.Shared.Ui.Auth
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject HttpClient Http
@inject AuthService Auth
@inject IStringLocalizer<AppStrings> Localizer

<select class="form-select form-select-sm lang-switcher" value="@_current"
        @onchange="OnChange" aria-label="@Localizer["Language"]">
    @foreach (var c in Cultures)
    {
        <option value="@c.Code">@c.Name</option>
    }
</select>

@code {
    // Native language names — these stay constant regardless of the selected culture.
    private static readonly (string Code, string Name)[] Cultures =
    [
        ("en", "English"),
        ("es", "Español"),
    ];

    private string _current = "en";

    protected override void OnInitialized() =>
        _current = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    private async Task OnChange(ChangeEventArgs e)
    {
        var code = e.Value?.ToString() ?? "en";
        if (code == _current) return;

        // Device-local store (survives the web reload), plus the in-process culture so the
        // MAUI webview reload picks it up (MauiProgram doesn't re-run on reload).
        await JS.InvokeVoidAsync("localStorage.setItem", "app_culture", code);
        CultureInfo.DefaultThreadCurrentCulture = CultureInfo.DefaultThreadCurrentUICulture = new CultureInfo(code);

        // Signed in: persist server-side so the choice follows the user across devices.
        if (Auth.IsAuthenticated)
        {
            try { await Http.PutAsJsonAsync("/api/auth/locale", new { locale = code }); }
            catch { /* best-effort; the local choice still applies */ }
        }

        Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }
}
