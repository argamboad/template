@using System.Net.Http.Json
@using Perezosoft.Shared.Ui.Auth
@inject IThemePersistence ThemePersistence
@inject IJSRuntime JS
@inject HttpClient Http
@inject AuthService Auth
@inject IStringLocalizer<AppStrings> Localizer

<select class="form-select form-select-sm theme-switcher" value="@_current" data-testid="theme-switcher"
        @onchange="OnChange" aria-label="@Localizer["Theme_Label"]">
    <option value="system">@Localizer["Theme_System"]</option>
    <option value="light">@Localizer["Theme_Light"]</option>
    <option value="dark">@Localizer["Theme_Dark"]</option>
</select>

@code {
    private string _current = "system";

    // theme.js already applied the saved mode before first paint; read it back so the
    // select reflects reality.
    protected override async Task OnInitializedAsync()
    {
        try { _current = await JS.InvokeAsync<string>("appTheme.current"); }
        catch { /* JS unavailable — show the "system" default */ }
    }

    private async Task OnChange(ChangeEventArgs e)
    {
        var theme = e.Value?.ToString() ?? "system";
        if (theme == _current) return;
        _current = theme;

        await JS.InvokeVoidAsync("appTheme.set", theme); // applies live — no reload
        await ThemePersistence.PersistAsync(theme);      // device store for the next cold start

        // Signed in: persist server-side so the choice follows the user across devices.
        if (Auth.IsAuthenticated)
        {
            try { await Http.PutAsJsonAsync("/api/auth/theme", new { theme }); }
            catch { /* best-effort; the local choice still applies */ }
        }
    }
}
