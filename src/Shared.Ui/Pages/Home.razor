@page "/"
@using Template.Shared.Ui.Auth
@inject AuthService Auth

<PageTitle>Home</PageTitle>

@if (Auth.IsAuthenticated)
{
    <div class="welcome-wrapper">
        <div class="welcome-card card shadow-sm text-center">
            <div class="card-body p-4 p-md-5">
                <img src="_content/Template.Shared.Ui/brand/lockup_light.svg" alt="Perezosoft"
                     class="welcome-lockup mb-4" />
                <h1 class="h3 fw-bold mb-1">Welcome back, @Auth.DisplayName!</h1>
                <p class="text-muted mb-0">
                    Signed in to the <strong>@Auth.TenantName</strong> household.
                </p>
                <!-- TODO: app-specific content goes here -->
            </div>
        </div>
    </div>
}
else
{
    <div class="welcome-wrapper">
        <div class="hero-section text-center">
            <img src="_content/Template.Shared.Ui/brand/lockup_light.svg" alt="Perezosoft"
                 class="welcome-lockup mb-4" />
            <p class="lead text-muted mb-4 mx-auto" style="max-width:480px">
                Sign in to get started with your household.
            </p>
            <a href="/login" class="btn btn-primary btn-lg px-5">Sign in &rarr;</a>
        </div>
    </div>
}
