@page "/admin"
@using System.Net.Http.Json
@using System.Text.Json.Serialization
@using Template.Shared.Ui.Auth
@inject AuthService Auth
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IStringLocalizer<AppStrings> Localizer

<PageTitle>@Localizer["Admin_Title"]</PageTitle>

<div class="admin-wrapper">
    <h1 class="h4 fw-bold mb-1">@Localizer["Admin_Title"]</h1>
    <p class="text-muted mb-4">@Localizer["Admin_Subtitle"]</p>

    @if (_state == State.Loading)
    {
        <div class="p-4 text-center text-muted">
            <span class="spinner-border spinner-border-sm me-2"></span>@Localizer["Common_Loading"]
        </div>
    }
    else if (_state == State.Forbidden)
    {
        <div class="alert alert-danger">
            @Localizer["Admin_Forbidden"]
            <a href="/" class="alert-link ms-1">@Localizer["Admin_BackHome"]</a>
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger py-2">@_error</div>
        }

        <div class="row g-4">
            @* ── Tenant list ── *@
            <div class="col-12 col-lg-5">
                <div class="card shadow-sm">
                    <div class="card-header py-2 fw-semibold small">
                        @Localizer["Admin_TenantsTitle"] <span class="text-muted">(@_tenants.Count)</span>
                    </div>
                    <div class="list-group list-group-flush" style="max-height:60vh;overflow-y:auto">
                        @foreach (var t in _tenants)
                        {
                            <button class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(t.Id == _selectedId ? "active" : "")"
                                    @onclick="() => SelectTenant(t.Id)">
                                <span class="text-truncate">@t.Name</span>
                                <span class="badge bg-secondary-subtle text-secondary-emphasis ms-2">@t.MemberCount</span>
                            </button>
                        }
                        @if (_tenants.Count == 0)
                        {
                            <div class="list-group-item text-muted small">@Localizer["Admin_NoTenants"]</div>
                        }
                    </div>
                </div>
            </div>

            @* ── Tenant detail ── *@
            <div class="col-12 col-lg-7">
                @if (_detailLoading)
                {
                    <div class="p-4 text-center text-muted">
                        <span class="spinner-border spinner-border-sm me-2"></span>@Localizer["Common_Loading"]
                    </div>
                }
                else if (_detail is not null)
                {
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h2 class="h6 fw-bold mb-1">@_detail.Name</h2>
                                    <div class="text-muted small">@_detail.Id</div>
                                </div>
                                <span class="badge bg-info-subtle text-info-emphasis">@_detail.SubscriptionStatus</span>
                            </div>

                            <dl class="row small mb-3">
                                <dt class="col-5 text-muted fw-normal">@Localizer["Admin_Created"]</dt>
                                <dd class="col-7">@_detail.CreatedAt.LocalDateTime.ToString("g")</dd>
                                <dt class="col-5 text-muted fw-normal">@Localizer["Admin_AuditEvents"]</dt>
                                <dd class="col-7">@_detail.AuditEventCount</dd>
                            </dl>

                            <h3 class="h6 fw-semibold mb-2">@Localizer["Admin_Members"] <span class="text-muted">(@_detail.Members.Count)</span></h3>
                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0">
                                    <thead>
                                        <tr class="small text-muted">
                                            <th>@Localizer["Admin_ColMember"]</th>
                                            <th>@Localizer["Admin_ColRole"]</th>
                                            <th class="text-end"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var m in _detail.Members)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="fw-medium small">@(string.IsNullOrEmpty(m.DisplayName) ? m.Email : m.DisplayName)</div>
                                                    @if (!string.IsNullOrEmpty(m.DisplayName))
                                                    {
                                                        <div class="text-muted" style="font-size:.75rem">@m.Email</div>
                                                    }
                                                </td>
                                                <td><span class="badge bg-light text-dark border">@m.Role</span></td>
                                                <td class="text-end">
                                                    <button class="btn btn-outline-warning btn-sm" disabled="@_busy"
                                                            @onclick="() => Impersonate(m)">
                                                        @Localizer["Admin_Impersonate"]
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-muted p-4 text-center border rounded">@Localizer["Admin_SelectTenant"]</div>
                }
            </div>
        </div>
    }
</div>

@code {
    private enum State { Loading, Forbidden, Ready }

    private State _state = State.Loading;
    private bool _busy;
    private bool _detailLoading;
    private string? _error;
    private List<TenantSummaryDto> _tenants = new();
    private Guid? _selectedId;
    private TenantDetailDto? _detail;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated) { Nav.NavigateTo("/login"); return; }
        if (!await Auth.IsStaffAsync()) { _state = State.Forbidden; return; }
        await LoadTenants();
        _state = State.Ready;
    }

    private async Task LoadTenants()
    {
        try
        {
            _tenants = await Http.GetFromJsonAsync<List<TenantSummaryDto>>("/api/admin/tenants") ?? new();
        }
        catch { _error = Localizer["Admin_ErrLoad"]; }
    }

    private async Task SelectTenant(Guid id)
    {
        _selectedId = id;
        _detail = null;
        _detailLoading = true;
        _error = null;
        try
        {
            _detail = await Http.GetFromJsonAsync<TenantDetailDto>($"/api/admin/tenants/{id}");
        }
        catch { _error = Localizer["Admin_ErrDetail"]; }
        finally { _detailLoading = false; }
    }

    private async Task Impersonate(MemberDto m)
    {
        var name = string.IsNullOrEmpty(m.DisplayName) ? m.Email : m.DisplayName;
        if (!await JS.ConfirmAsync(Localizer["Admin_ConfirmImpersonate", name])) return;

        _busy = true; _error = null;
        try
        {
            var res = await Http.PostAsync($"/api/admin/impersonate/{m.UserId}", null);
            if (res.IsSuccessStatusCode)
            {
                var body = await res.Content.ReadFromJsonAsync<ImpersonationDto>();
                if (!string.IsNullOrEmpty(body?.AccessToken))
                {
                    // Swap the in-memory session to the short-lived impersonation token, then hand off
                    // to the app as that user (client-side nav keeps the token; a reload would restore staff).
                    Auth.BeginImpersonation(body.AccessToken);
                    Nav.NavigateTo("/");
                    return;
                }
            }
            _error = Localizer["Admin_ErrImpersonate"];
        }
        catch { _error = Localizer["Admin_ErrImpersonate"]; }
        finally { _busy = false; }
    }

    private sealed record TenantSummaryDto
    {
        [JsonPropertyName("id")] public Guid Id { get; init; }
        [JsonPropertyName("name")] public string Name { get; init; } = string.Empty;
        [JsonPropertyName("member_count")] public int MemberCount { get; init; }
        [JsonPropertyName("created_at")] public DateTimeOffset CreatedAt { get; init; }
    }

    private sealed record TenantDetailDto
    {
        [JsonPropertyName("id")] public Guid Id { get; init; }
        [JsonPropertyName("name")] public string Name { get; init; } = string.Empty;
        [JsonPropertyName("created_at")] public DateTimeOffset CreatedAt { get; init; }
        [JsonPropertyName("members")] public List<MemberDto> Members { get; init; } = new();
        [JsonPropertyName("subscription_status")] public string SubscriptionStatus { get; init; } = string.Empty;
        [JsonPropertyName("audit_event_count")] public int AuditEventCount { get; init; }
    }

    private sealed record MemberDto
    {
        [JsonPropertyName("user_id")] public Guid UserId { get; init; }
        [JsonPropertyName("display_name")] public string? DisplayName { get; init; }
        [JsonPropertyName("email")] public string Email { get; init; } = string.Empty;
        [JsonPropertyName("role")] public string Role { get; init; } = string.Empty;
    }

    private sealed record ImpersonationDto
    {
        [JsonPropertyName("access_token")] public string? AccessToken { get; init; }
        [JsonPropertyName("expires_in")] public int ExpiresIn { get; init; }
    }
}
