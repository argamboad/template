@page "/auth-error"

<PageTitle>Sign-in failed</PageTitle>

<div class="auth-error text-center py-5">
    <div class="error-icon mb-3" style="font-size:3rem">&#9888;</div>
    <h1 class="h4 fw-bold mb-2">Authentication failed</h1>
    <p class="text-muted mb-4 mx-auto" style="max-width:420px">
        We couldn't sign you in. Please try again.
    </p>
    <a href="/login" class="btn btn-primary">Back to sign in</a>
</div>
